# Dependencies
node_modules
**/node_modules
frontend/node_modules
backend/node_modules

# Build outputs
frontend/dist
!backend/dist
!backend/dist/**

# Logs
*.log
npm-debug.log*

# Environment & Secrets (Never commit API keys or environment secrets)
.env
**/.env
