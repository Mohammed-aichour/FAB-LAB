# Port configured dynamically by environment
PORT=5000

# Allowed frontend origin for CORS
FRONTEND_URL=https://mohammed-aichour.github.io
FRONTEND_ORIGIN=https://mohammed-aichour.github.io

# Secret key for JWT authentication (minimum 32 characters)
JWT_SECRET=YOUR_JWT_SECRET

# OpenAI API Key for AI Assistant & Function Calling
OPENAI_API_KEY=YOUR_AI_API_KEY

# OpenAI Model configuration
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional: Database directory path
GMAO_DATA_DIR=../../data_db
