# Port configured dynamically by Render or local fallback
PORT=5000

# Allowed frontend origin(s) for CORS (comma-separated for multiple origins)
FRONTEND_ORIGIN=https://mohammed-aichour.github.io,http://localhost:5173

# Secret key for JWT authentication (minimum 32 characters)
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long

# OpenAI API Key for AI Assistant & Function Calling
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model configuration
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional: Database directory override
GMAO_DATA_DIR=../../data_db
